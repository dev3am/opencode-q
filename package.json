{
	"name": "opencode-q",
	"version": "1.1.2",
	"description": "Prompt queue plugin for OpenCode",
	"keywords": [
		"opencode",
		"opencode-plugin",
		"prompt-queue",
		"ai",
		"agent",
		"task-queue",
		"open-source"
	],
	"type": "module",
	"main": "./dist/plugin.js",
	"exports": {
		".": "./dist/plugin.js"
	},
	"files": [
		"dist/",
		"scripts/"
	],
	"scripts": {
		"preuninstall": "node scripts/preuninstall.cjs",
		"postinstall": "node scripts/postinstall.cjs",
		"build": "bun run build:plugin && bun run build:web",
		"build:plugin": "bun build src/plugin.ts --outfile dist/plugin.js --target bun",
		"build:web": "cd web && bun run build && rm -rf ../dist/web && cp -r dist ../dist/web",
		"test": "bun test",
		"lint": "biome check src web/src scripts",
		"dev": "bun run build && echo 'Built to dist/'",
		"reload": "bun run build && node scripts/sync-runtime.cjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@opencode-ai/plugin": "^1.15.10"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@types/bun": "^1.3.14",
		"@vitejs/plugin-react": "^6.0.2",
		"husky": "^9.1.7",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"vite": "^8.0.14"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/dev3am/opencode-q.git"
	},
	"homepage": "https://github.com/dev3am/opencode-q#readme",
	"bugs": {
		"url": "https://github.com/dev3am/opencode-q/issues"
	}
}
