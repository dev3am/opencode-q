{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": ".",
		"types": ["bun-types"]
	},
	"include": ["src/**/*.ts", "cli/**/*.ts"],
	"exclude": ["node_modules", "dist", "web"]
}
